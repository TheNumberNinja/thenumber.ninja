---
// A drawn tick for "what's included" lists. Decorative: the list item says it.
export interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 18 18"
  width="18"
  height="18"
  aria-hidden="true"
  focusable="false">
  <path
    d="M2 9.5l4.5 4.5L16 4"
    fill="none"
    stroke="currentColor"
    stroke-width="2.6"
  />
</svg>
